{
  "name": "translate-md",
  "version": "1.0.0",
  "description": "A Github Action to translate Readme to a different language",
  "main": "index.js",
  "scripts": {
    "build": "ncc build ./index.js -o dist --source-map",
    "build:commit": "npm run build && git add . && git commit",
    "test": "node --test tests/*.test.js",
    "test:coverage": "c8 npm test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check:dist": "node scripts/check-dist.js",
    "verify": "npm run lint && npm run test:coverage && npm run check:dist"
  },
  "keywords": [
    "readme",
    "translate",
    "translator"
  ],
  "author": "Ephraim Atta-Duncan",
  "license": "ISC",
  "dependencies": {
    "@actions/core": "^1.2.6",
    "@vitalets/google-translate-api": "^9.2.1",
    "http-proxy-agent": "^4.0.1",
    "remark-parse": "^8.0.3",
    "remark-stringify": "^8.1.1",
    "simple-git": "^4.1.0",
    "tunnel": "0.0.6",
    "unified": "^9.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vercel/ncc": "^0.38.0",
    "c8": "^10.1.3",
    "eslint": "^9.39.5"
  },
  "c8": {
    "all": true,
    "include": [
      "src/**/*.js"
    ],
    "exclude": [
      "tests/**",
      "dist/**",
      "coverage/**"
    ],
    "reporter": [
      "text",
      "lcov"
    ],
    "check-coverage": true,
    "lines": 90,
    "functions": 90,
    "branches": 85,
    "statements": 90
  }
}
